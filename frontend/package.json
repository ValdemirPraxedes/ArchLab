{
  "name": "archlab-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typegen": "openapi-typescript ../docs/api/openapi.yaml -o src/api/generated/schema.d.ts",
    "prebuild": "npm run typegen",
    "build": "tsc -b && vite build",
    "pretest": "npm run typegen",
    "test": "vitest run",
    "test:integration": "node scripts/integration.mjs",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@xyflow/react": "^12.9.0",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "msw": "^2.8.0",
    "openapi-typescript": "^7.8.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
