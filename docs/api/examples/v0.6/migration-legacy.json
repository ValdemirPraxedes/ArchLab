{
  "legacy": {
    "components": [
      {
        "id": "old-db",
        "type": "DATABASE",
        "displayName": "Legacy Database",
        "processingMs": 5
      }
    ],
    "connections": []
  },
  "migration": {
    "from": "DATABASE",
    "to": "RELATIONAL_DATABASE",
    "requiresConfirmation": true,
    "preserve": [
      "id",
      "displayName",
      "connections",
      "queryText",
      "responseText",
      "behaviorIds",
      "actionIds",
      "dependsOn"
    ],
    "convert": {
      "processingMs": "readLatencyMs and writeLatencyMs",
      "CALL": "DB_SELECT (collection default)",
      "concurrency": "maxConcurrentOperations = connectionPoolSize = 1000"
    },
    "blocked": [
      "NON_QUERY_CONNECTION",
      "HISTORICAL_CALL_TIMEOUT"
    ],
    "policy": "docs/architecture/MIGRATION-V6-001.md (product decision 2, 2026-11-07)"
  }
}
