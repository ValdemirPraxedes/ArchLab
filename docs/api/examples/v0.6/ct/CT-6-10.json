                  "actions": [
                    {
                      "id": "bulk",
                      "kind": "DB_BULK_INSERT",
                      "connectionId": "data",
                      "recordCount": 100001
                    }
                  ]
                }
              ]
            },
            {
              "id": "db",
              "type": "RELATIONAL_DATABASE",
              "displayName": "db",
              "dataProperties": {
                "initialRecordCount": 0,
