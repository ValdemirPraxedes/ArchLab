            },
            {
              "id": "data",
              "sourceId": "service",
              "targetId": "db",
              "latencyMs": 1,
              "integration": {
                "kind": "DATABASE_QUERY"
              }
            }
          ]
        },
        "scenario": {
          "entry": {
            "componentId": "client",
