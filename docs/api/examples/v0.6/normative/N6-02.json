{
  "id": "N6-02",
  "title": "Limite de registros (1.000.000): DB_BULK_INSERT é atômico — acima do espaço livre nada é gravado; o espaço exato é aceito. 'over' e 'exact' são independentes e executam em ordem FIFO no pool 1; uma Action que depende de outra que falhou não executa (DEPENDENCY_FAILED, ver N6-04).",
  "cases": [
    {
      "name": "bulk-atomic-at-record-limit",
      "endpoint": "/api/v1/simulations",
      "replay": true,
      "request": {
        "architecture": {
          "schemaVersion": "0.6",
          "components": [
            {
              "id": "client",
              "type": "WEB_BROWSER",
              "displayName": "Client"
            },
            {
              "id": "service",
              "type": "SERVICE",
              "displayName": "Service",
              "behaviors": [
                {
                  "id": "handle",
                  "trigger": "REQUEST_RECEIVED",
                  "actions": [
                    {
                      "id": "over",
                      "kind": "DB_BULK_INSERT",
                      "connectionId": "data",
                      "recordCount": 51
                    },
                    {
                      "id": "exact",
                      "kind": "DB_BULK_INSERT",
                      "connectionId": "data",
                      "recordCount": 50
                    },
                    {
                      "id": "full",
                      "kind": "DB_INSERT",
